# NOTE: apps/civitics/.env.local is a symlink to this directory's .env.local
# (FIX-304). Don't create a real file in its place — Next dev reads the
# apps-level file with priority over root, which silently shadows root.
# Recreate the symlink if it ever goes missing:
#   New-Item -ItemType SymbolicLink -Path "apps\civitics\.env.local" `
#     -Target "C:\<repo>\.env.local"   (or `mklink apps\civitics\.env.local ..\..\.env.local` from elevated cmd)

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_MANAGEMENT_API_KEY=
# Read-only role for the integrity audit (postgresql://cowork_readonly:...@db.<ref>.supabase.co:5432/postgres?sslmode=require)
COWORK_READONLY_DB_URL=
# Personal Access Token from supabase.com/dashboard/account/tokens — used by
# /api/platform/usage to pull live request counts, function invocations, and
# disk utilization from the Supabase Management API for the Platform Costs card.
# Optional: if unset, the SQL-derived metrics (db_size_bytes, storage_bytes)
# still work; only the Management API rows fall back to whatever is in the DB.
SUPABASE_MANAGEMENT_API_KEY=

# Anthropic
# Use CIVITICS_ANTHROPIC_API_KEY (not ANTHROPIC_API_KEY) so Claude Code CLI
# uses its own Pro subscription instead of this key.
CIVITICS_ANTHROPIC_API_KEY=
ANTHROPIC_ADMIN_API_KEY=
ANTHROPIC_ORG_ID=

# Enrichment mode for AI tagger + summaries pipelines
# 'inline' — call Anthropic API directly (default, current behavior)
# 'queue'  — stage work in enrichment_queue; a worker enriches later
CIVITICS_ENRICHMENT_MODE=


# Mapbox (when needed)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Storage (Supabase now, R2 later)
STORAGE_PROVIDER=r2

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_DOCUMENTS=civitics-documents
CLOUDFLARE_R2_BUCKET_CACHE=civitics-cache
CLOUDFLARE_R2_PUBLIC_URL_DOCUMENTS=

# Vercel (for deployment status + platform-usage dashboard cards)
# The platform/vercel route + getVercelUsage() helper read VERCEL_API_TOKEN.
# VERCEL_TEAM_ID is optional and only needed for team-scoped tokens.
# REST API token for /api/platform/vercel and vercel-usage.ts.
# NOT a `vercel` CLI token — passing this to `vercel --token <...>`
# will error. CLI tokens are generated separately in the dashboard.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_AI_API_TOKEN=

# Data Pipelines
CONGRESS_API_KEY=
COURTLISTENER_API_KEY=
OPENSTATES_API_KEY=
FEC_API_KEY=
REGULATIONS_API_KEY=

# Resend (transactional email — kill switch alerts + sync canary)
# RESEND_API_KEY: account API key from https://resend.com/api-keys ("re_xxx").
# RESEND_FROM: must be on a verified domain (e.g. alerts@civitics.com) or
#   onboarding@resend.dev for unverified setups.
# EMAIL_ALERTS_ENABLED: 'true' to enable kill-switch flip alerts + cumulative
#   metric-threshold alerts. Defaults to false (no-op even when the API key is
#   present). Set to true in prod once the recipient and from address are
#   confirmed. NOTE (FIX-642): the leading-signal db_connections alert fires
#   regardless of this toggle (connection exhaustion takes the site down), so
#   long as ADMIN_EMAIL + RESEND keys are set.
# LEADING_DB_CONN_THRESHOLD (FIX-642): absolute db_connections value that trips
#   the leading-signal early alert. Default 45 (75% of the 60-conn ceiling).
#   Set low temporarily to verify the alert fires.
RESEND_API_KEY=
RESEND_FROM=
EMAIL_ALERTS_ENABLED=
LEADING_DB_CONN_THRESHOLD=

# IRS 990 pipeline (FIX-250). Comma-separated tax years to ingest from the IRS
# bulk e-file distribution. Default: last 3 years (current year is usually 1-mo
# behind, but partial ingest is fine).
IRS990_TAX_YEARS=


# Bot protection — durable edge rate limiter (FIX-570). Upstash Redis REST
# credentials (free tier, AUTO-UPGRADE OFF for a hard $0 cost ceiling). When
# absent, the edge limiter fails OPEN (allow-all; per-user DB caps still apply)
# so the app builds and serves without them. Add to .env.local + Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bot protection — Cloudflare Turnstile (FIX-568). Site key is public (client
# widget); secret is server-only AND mirrored into the Supabase dashboard
# (Auth → Bot and Abuse Protection). Local dev uses Cloudflare's published test
# keys (site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY must be in BOTH .env.local files (root + apps/civitics/).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Abuse-event log pepper (FIX-880 / FIX-571 PR1). Server-only secret used to
# HMAC-SHA256 network identifiers before they're stored in the observe-only
# abuse_events integrity log — raw IP/UA are NEVER stored. Must be STABLE (never
# rotated: rotating breaks cross-week linkage, which is the whole point). Unset →
# events still log but with NULL hashes (linkage-blind, fail-open). Generate with
# `openssl rand -hex 32`. Put it in BOTH .env.local files (root + apps/civitics/)
# AND Vercel.
ABUSE_EVENT_PEPPER=

### NOT ACTIVE YET - for future use
# Sentry (when needed)
NEXT_PUBLIC_SENTRY_DSN=




CRON_SECRET=

# Admin dashboard access — must match the Supabase auth email for the admin account
# Controls access to manual pipeline triggers and budget controls on the dashboard
ADMIN_EMAIL=

# Feature flags — set to 'false' to disable without a code deploy
# CONNECTIONS_PIPELINE_ENABLED=false
# The three AI hard-kills are the env-level layer above the DB-backed
# switches and the auto-trip evaluator (FIX-282 / FIX-286 / FIX-311).
# Set to 'false' to disable the corresponding AI feature.
# AI_SUMMARIES_ENABLED=false   # /api/officials/[id]/summary, /api/proposals/[id]/summary, ai-summaries pipeline
# AI_NARRATIVE_ENABLED=false   # /api/graph/narrative + ✨ Explain button on /graph
# AI_TAGGER_ENABLED=false      # ai-tagger pipeline
# CHORD_DATA_ENABLED=false
# CRON_DISABLED=true
# MAPBOX_GEOCODING_ENABLED=false  # /api/auth/verify-constituent (layered above kill_switches.mapbox_geocode)
GITHUB_TOKEN=

# GitHub billing-API token — used by getGitHubUsage() to pull Actions minutes
# + shared-storage for the Platform Costs card. The civitics repo is owned by
# the `civitics-platform` USER account (not an org), so the helper hits the
# enhanced-billing user endpoint:
#   /users/civitics-platform/settings/billing/usage?year=YYYY&month=MM
# (The legacy /settings/billing/actions + /settings/billing/shared-storage
# endpoints return HTTP 410 "This endpoint has been moved" as of May 2026.)
# Kept separate from GITHUB_TOKEN (the deploy/CI token, which has read:org +
# repo scope) so adding billing scope doesn't widen that token's blast radius.
#
# Required scopes (either path works):
#   - Fine-grained PAT (owned by civitics-platform): account permission
#     "Plan" set to Read-only
#   - Classic PAT: `user` scope (broader — also grants profile read)
#
# Mint at: https://github.com/settings/personal-access-tokens/new (fine-grained)
#          or https://github.com/settings/tokens (classic)
#
# Optional: if unset, github.action_minutes + github.storage_bytes stay on
# their last source='manual' value; the snapshot does NOT trip partial=true
# on a missing token (matches the Cloudflare/Vercel benign-absence convention).
GITHUB_BILLING_TOKEN=

# FIX-573: Google OAuth sign-in. Local Supabase reads these via the env(...)
# refs in supabase/config.toml [auth.external.google] (run `supabase stop &&
# supabase start` after setting them so config.toml re-reads). PROD is NOT
# configured here — set the client ID/secret in the Supabase dashboard
# (Auth → Providers → Google). Create the OAuth 2.0 Web client in Google Cloud
# Console with redirect URIs:
#   https://xsazcoxinpgttgquwvuf.supabase.co/auth/v1/callback  (prod)
#   http://127.0.0.1:54321/auth/v1/callback                   (local)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

