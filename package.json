{
  "name": "civitics",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "session:check": "node scripts/session-check.mjs",
    "session:worktree": "node scripts/session-worktree.mjs create",
    "session:worktree:done": "node scripts/session-worktree.mjs done",
    "session:worktree:test": "node scripts/test-session-worktree.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "fixes:sync": "node scripts/fixes-sync.mjs",
    "fixes:sync:dry": "node scripts/fixes-sync.mjs --dry-run",
    "fixes:check": "node scripts/fixes-sync.mjs --check",
    "fixes:check:trunk": "node scripts/fixes-sync.mjs --check-trunk",
    "fixes:test": "node scripts/test-fixes-sync.mjs",
    "fixes:housekeep": "node scripts/fixes-housekeep.mjs",
    "fixes:housekeep:dry": "node scripts/fixes-housekeep.mjs --dry-run",
    "fixes:clean": "node scripts/fixes-clean.mjs",
    "fixes:clean:dry": "node scripts/fixes-clean.mjs --dry-run",
    "fixes:archive": "node scripts/fixes-archive.mjs",
    "fixes:archive:dry": "node scripts/fixes-archive.mjs --dry-run",
    "fix:add": "node scripts/fix-add.mjs",
    "check:reads": "node scripts/check-silent-reads.mjs",
    "check:render-timeouts": "node scripts/check-render-timeouts.mjs",
    "db:push:prod": "node scripts/db-push-prod.mjs"
  },
  "devDependencies": {
    "supabase": "2.78.1",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "supabase"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
