#!/bin/sh
# .githooks/pre-push — block a push when FIXES.md / done.log are out of sync
# with commit trailers (FIX-461 made `fixes:check` fail on off-trunk done.log
# completions and FIXES.md/trailer drift). Today that gate only ran in CI, i.e.
# AFTER a bad sync was already pushed. This moves it BEFORE the push.
#
# Wired via `git config core.hooksPath .githooks` (set by the root package.json
# `prepare` script — no husky, no extra deps). Git for Windows runs hooks
# through its bundled `sh`, so this POSIX script works on Craig's Windows box.
#
# Bypass (use sparingly, and never to dodge a real drift): `git push --no-verify`.

echo "[pre-push] running pnpm fixes:check ..."
if ! pnpm fixes:check; then
  echo ""
  echo "[pre-push] ✗ fixes:check failed — push aborted."
  echo "[pre-push]   FIXES.md / done.log are out of sync with commit trailers."
  echo "[pre-push]   Run \`pnpm fixes:sync\`, commit the diff, then push again."
  exit 1
fi

echo "[pre-push] ✓ fixes:check clean."
exit 0
