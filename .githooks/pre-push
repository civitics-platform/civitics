#!/bin/sh
# .githooks/pre-push — block a push when done.log claims a FIX-ID shipped whose
# code is not an ancestor of trunk (FIX-461 silent-zero-sweep-tail incident).
# Runs BEFORE the push, not just in CI after a bad sync already landed.
#
# Uses `fixes:check:trunk` (--check-trunk), NOT the full `fixes:check`. The
# standard loop pushes the `Fixes:` code commit and its follow-up `fixes:sync`
# commit as TWO separate pushes, so the code-commit push is always transiently
# out of sync (done.log not yet appended, checkbox not yet flipped). The full
# drift check would abort that first push every single time — exactly the
# false-positive that reds-out the CI guard. The trunk-ancestry violation is the
# dangerous case and is what this hook enforces. Drift is gated on PRs in CI
# (fixes-integrity.yml), where code + sync are evaluated together.
#
# Wired via `git config core.hooksPath .githooks` (set by the root package.json
# `prepare` script — no husky, no extra deps). Git for Windows runs hooks
# through its bundled `sh`, so this POSIX script works on Craig's Windows box.
#
# Bypass (use sparingly, and never to dodge a real off-trunk completion):
# `git push --no-verify`.

echo "[pre-push] running @civitics/data typecheck ..."
if ! pnpm --filter @civitics/data typecheck; then
  echo ""
  echo "[pre-push] ✗ @civitics/data typecheck failed — push aborted."
  echo "[pre-push]   The data package has no build step in CI, so a TS error here only"
  echo "[pre-push]   surfaces when a pipeline runs (FIX-482/FIX-M). Fix the type error,"
  echo "[pre-push]   or bypass with --no-verify if this is a genuine WIP push."
  exit 1
fi
echo "[pre-push] ✓ @civitics/data typecheck clean."

echo "[pre-push] running pnpm fixes:check:trunk ..."
if ! pnpm fixes:check:trunk; then
  echo ""
  echo "[pre-push] ✗ fixes:check:trunk failed — push aborted."
  echo "[pre-push]   done.log claims a FIX-ID shipped whose code is not on trunk."
  echo "[pre-push]   Re-land the code on main, then append the real SHA via fixes:sync."
  exit 1
fi

echo "[pre-push] ✓ fixes:check:trunk clean."
exit 0
